# ============================================================================
# STUDY HELPER DOC — TELEGRAM DELIVERY BOT (Render)
# Copy to .env locally, ya Render → Environment me ye values daalein.
# ============================================================================

# 1) @BotFather se bot token
BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# 2) ⚠️ SAME value jo Vercel par ADMIN_SESSION_SECRET hai
#    (isse site ke "Open in Telegram" link decrypt hote hain)
ADMIN_SESSION_SECRET="same-secret-as-vercel"

# 3) Join gate — channel jahan bot ADMIN hai
#    @username form ya -100xxxxxxxxxx form
CHANNEL_ID="@your_channel_username"
CHANNEL_URL="https://t.me/your_channel_username"
CHANNEL_INVITE_URL=""          # optional (private channel ke liye invite link)

# 4) Render public URL (https://your-service.onrender.com)
#    Khaali chhoda to bot polling mode me chalega
WEBHOOK_URL=""

# 5) Auto delete timer (ghante) — default 3
SESSION_TTL_HOURS="3"

PORT="3000"

# ============================================================================
# 🤖 Study helper Doc — Telegram Delivery Bot : environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` next to bot.py and fill the values:
#     cp .env.example .env
# Everything here is OPTIONAL if the website's encrypted Firebase vault already
# has apiId / apiHash / botToken — env always wins over the vault.
# ============================================================================

# ── 1. Telegram API credentials (my.telegram.org → API development tools) ──
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── 2. Bot token (@BotFather → /newbot → token) ────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── 3. USER session (the account that is a member of your content channels) ─
# ⚠️  Do NOT reuse the website's GramJS session — Telegram kills a session
#     that is opened from two IPs at once (406 AUTH_KEY_DUPLICATED).
#     Create a dedicated one with:   python3 bot.py --login
#     Then paste the printed string here (keep the quotes).
TG_SESSION_STRING=

# ── 4. Firebase Realtime Database (shared brain with the website) ───────────
# Without these the bot falls back to a local SQLite file (bot_state.db) and
# CANNOT see requests made on the website — so fill these in for real use.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=
# Multi-line PEM key: keep it as one line, \n is expanded automatically.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── 5. Shared secret (MUST be identical to the website's Vercel value) ──────
# Used to decrypt the vault and to sign/verify session cookies.
# Website: Vercel → Project → Settings → Environment Variables.
ADMIN_SESSION_SECRET=

# ── 6. Owner / admin Telegram IDs (bot commands only work for these) ────────
OWNER_TG_ID=
ADMIN_TG_IDS=

# ── 6b. 🔒 Channel join-gate (optional) ─────────────────────────────────────
# Delivery se pehle channel membership zaroori karni ho to Admin Panel se ON
# karein (Telegram Bot Delivery → Channel join gate). Panel ki value jeetti hai;
# ye env sirf tab use hote hain jab panel me channel khaali chhoda ho —
# JOIN_GATE_CHANNEL bharte hi gate apne aap ON maana jata hai.
# Bot ko us channel me ADMIN banana zaroori hai, warna gate fail-open rehta hai.
# JOIN_GATE_CHANNEL=@your_channel
# JOIN_GATE_INVITE_URL=https://t.me/+AbCdEfGhIjKlMnOp

# ── 7. Tuning (all optional, defaults shown) ────────────────────────────────
BOT_MAX_PARALLEL=2
BOT_DOWNLOAD_DIR=
BOT_STATE_DB=
BOT_SEARCH_BUDGET_SEC=120

# Media-token expiry for in-app streaming (website side; bot ignores it)
TG_MEDIA_TOKEN_TTL_DAYS=30

# ── 7b. 🩺 HEALTH SERVER (Render / Railway / Fly "Web Service") ─────────────
# Free tier par "Background Worker" nahi milta, isliye bot ko ek HTTP port
# kholna padta hai. Render khud `PORT` deta hai — use YAHAN set mat karna,
# bot apne aap usi par health server chala dega.
#   GET /healthz  → 200 (process zinda)   • Render health check path yahi hai
#   GET /ready    → 200 jab Telegram connected, warna 503
#   GET /status   → uptime/config/queue (koi secret nahi dikhta)
#
# VPS/local par PORT set nahi hota, isliye koi port nahi khulta (jaisa pehle tha).
# BOT_DISABLE_HEALTH=1
# BOT_HEALTH_PORT=8080          # Render ke PORT ko override karna ho to
# BOT_HEALTH_TOKEN=             # set kiya to /status token maangega (/healthz public)
# BOT_NO_RETRY=1                # startup fail par retry band (Render par retry ON rakhein)
# PYTHONUNBUFFERED=1            # logs turant dikhein

# ── 7c. Free-tier tuning (512 MB RAM / ephemeral disk) ─────────────────────
# BOT_DOWNLOAD_DIR=/tmp/shd_downloads
# BOT_STATE_DB=/tmp/shd_bot_state.db

# ── 8. Cloudflare Worker shared secret (only if you run the worker too) ─────
# The website DERIVES this from ADMIN_SESSION_SECRET (HMAC-SHA256, label
# `shd_cloudflare_worker_v1`). Do not invent a value — copy it from
# Admin Panel → Telegram Bot Delivery → Cloudflare Worker Secret.
# (Put it in cloudflare-worker/worker.js, NOT here. Listed for reference.)
# WORKER_SHARED_SECRET=

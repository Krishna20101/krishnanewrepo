{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/data/:path*", "destination": "/api/deny.js" },
    { "source": "/bot/:path*", "destination": "/api/deny.js" },
    { "source": "/server.js", "destination": "/api/deny.js" },
    { "source": "/render.yaml", "destination": "/api/deny.js" },
    { "source": "/package.json", "destination": "/api/deny.js" },
    { "source": "/package-lock.json", "destination": "/api/deny.js" },
    { "source": "/database.rules.json", "destination": "/api/deny.js" }
  ]
}

# =============================================================================
# 📝 Study helper Doc — environment variables
# -----------------------------------------------------------------------------
# Copy kijiye:  cp .env.example .env.local
# ⚠️ Values me `#` ho to poora value DOUBLE QUOTES me likhiye
#    (galat:  KEY=abc#123   sahi:  KEY="abc#123")
# =============================================================================

# ── 1) Server (website + API) ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME="Study helper Doc"

# ── 2) 🔐 Master secret (website + bot DONO me bilkul SAME) ─────────────────
#    Isi se Telegram tokens encrypt hote hain. Production me missing → server
#    start hi nahi hoga (koi weak fallback nahi).
#    Banaiye:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Admin login (ya upar wali secret + ADMIN_EMAIL_HASH/ADMIN_PASSWORD_HASH/ADMIN_SALT)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: hashed admin credentials (pbkdf2 sha512, 100k iterations)
# ADMIN_EMAIL_HASH=
# ADMIN_PASSWORD_HASH=
# ADMIN_SALT=

# Optional: student sessions ke liye alag secret (default: "student::" + ADMIN_SESSION_SECRET)
# STUDENT_SESSION_SECRET=

# ── 3) 🔥 Firebase Realtime Database ────────────────────────────────────────
#    Service account key (JSON) se:  project_id, client_email, private_key
#    private_key me \n literal chalega — server PEM me convert kar deta hai.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Local testing bina Firebase ke → data /tmp/shd_local_store.json me jaata hai
# LOCAL_STORE_PATH=/tmp/shd_local_store.json

# ── 4) 🤖 Telegram bot (bot/bot.py — Render Web Service) ────────────────────
#    my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
#    @BotFather se mila token
TELEGRAM_BOT_TOKEN=
#    USER session string (sirf bot ke liye!) — banaiye:  python bot/bot.py --login
#    🧑 PRIVATE channel/group se video ISI session se download hoti hai (kyunki yeh
#       account us channel ka member hai) — bot ko wahan admin/member hona zaroori nahi.
#       Download ke baad file BOT student ko bhejta hai (source ki pehchaan nahi dikhti).
#    ⚠️ Yeh website ko NAHI chahiye. Website ab GramJS use hi nahi karti.
TG_SESSION_STRING=

#    Apna Telegram numeric id (owner) — /stats, /pause jaise admin commands
OWNER_TG_ID=
#    Extra admin ids (comma separated)
# ADMIN_TG_IDS=

#    Delivery behaviour
BOT_MAX_PARALLEL=1
BOT_DOWNLOAD_DIR=/tmp/shd_downloads
BOT_STATE_DB=/tmp/shd_bot_state.db
# BOT_SEARCH_BUDGET_SEC=120
# BOT_NO_RETRY=1
# BOT_DISABLE_HEALTH=1
# BOT_HEALTH_PORT=8080        # default: $PORT (Render)
# BOT_HEALTH_TOKEN=           # set karne par /status token maangta hai

#    Website ke liye bot ka username (deep link: t.me/<username>?start=req_<id>)
TELEGRAM_BOT_USERNAME=

# ── 5) 🔒 Channel join-gate (bot) ───────────────────────────────────────────
#    ON karne par video se pehle channel join zaroori (bot ko channel me ADMIN hona chahiye)
# (JOIN_GATE_ENABLED naam ka koi env var nahi hai — JOIN_GATE_CHANNEL set hote hi gate ON ho jata hai)
# JOIN_GATE_CHANNEL=@yourchannel        # ya -100xxxxxxxxxx
# JOIN_GATE_INVITE_URL=https://t.me/yourchannel

# ── 5b) 🧲 AUTO-SCAN (sirf bot) — channel → course links khud attach ────────
#    Kaun se channels padhne hain? 10-15 ids comma/space separated likhiye:
#      @handle  ·  -100xxxxxxxxxx  ·  https://t.me/+AbCdEf (invite)
#    Yahi list delivery-search ko bhi limit karti hai — baaki saare dialogs
#    ignore hote hain (galat channel ki video match hone ka chance khatam).
#    Khaali = auto-scan band (sirf admin ke "Add by URL" par chalega).
BOT_SCAN_CHATS=
#    Attach karne ke liye minimum match score (0-100). 75 = balanced (recommended).
#    88 = sirf lagbhag-pakka match · 60 = delivery threshold jitna dheela.
BOT_SCAN_MIN_SCORE=75
#    Har channel ke kitne RECENT messages padhne hain (bade channel ke liye badhaiye)
BOT_SCAN_MESSAGE_LIMIT=400
#    Course JSON ka folder (default: <repo>/data/batches) — Render par apne aap sahi
# BOT_DATA_DIR=

# ── 6) Media token lifetime ────────────────────────────────────────────────
#    0 = attached links KABHI expire nahi hote (recommended: link ek fixed
#        Telegram message ko point karta hai). Website aur bot DONO me same rakhiye.
#    30 = har 30 din baad links mar jayenge → dobara scan/attach karna padega.
TG_MEDIA_TOKEN_TTL_DAYS=0

# ── 7) CORS (optional) ─────────────────────────────────────────────────────
#    Khali = same-origin + preview host allowed. Comma separated origins:
# CORS_ALLOWED_ORIGINS=https://studyhelperdoc.vercel.app

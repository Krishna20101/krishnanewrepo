# ==============================================================================
# STUDY HELPER DOC — 100% SERVER-ONLY ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# Copy this file to `.env` for local development, or add these keys in:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# 1. PUBLIC DOMAIN / BRANDING PLACEHOLDERS
NEXT_PUBLIC_SITE_URL="https://studyhelperdoc.vercel.app"
TELEGRAM_JOIN_URL="https://t.me/REPLACE_WITH_YOUR_TELEGRAM_CHANNEL"
DEFAULT_IMAGE_URL=""
APP_LOGO_URL=""
DEFAULT_YOUTUBE_URL=""

# 2. ADMIN LOGIN ID & PASSWORD (REQUIRED — ZERO DEFAULT PASSWORD IN CODE!)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# 3. FIREBASE REALTIME DATABASE + SERVICE ACCOUNT (SERVER-ONLY)
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_URL=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# 4. OPTIONAL: TELEGRAM & CLOUDFLARE EDGE STREAM WORKER
# (You DO NOT have to put these in Vercel .env — you can paste & encrypt them
# directly inside `/admin` -> `Telegram Sync Studio` & `Website Settings`!)
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_SESSION_STRING=""

# 🤖 @BotFather BOT TOKEN (STRONGLY RECOMMENDED — 100% FREE)
# Bot ko apne channel/group me ADMIN bana dein. Iske baad saari video/PDF
# streaming BOT se hoti hai -> har Vercel/Cloudflare container apni alag
# temporary auth_key banata hai -> `406 AUTH_KEY_DUPLICATED` KABHI nahi aata,
# aur channel ko 100% PRIVATE rakh sakte hain.
# Bot token yahan ya /admin -> Telegram Sync Studio (Box 1) me daal sakte hain.
TELEGRAM_BOT_TOKEN=""

CLOUDFLARE_STREAM_WORKER_URL=""

# ==============================================================================
# 5. 🤖 TELEGRAM DELIVERY BOT ("Open in Telegram")
# ==============================================================================
# ⚠️ SAHI VAR NAME:  TELEGRAM_BOT_USERNAME   (NEXT_PUBLIC_ wala NAHI!)
#    Code sirf ye padhta hai: src/lib/botDelivery.ts + src/lib/db.ts.
#    Bot khud bhi apna username `bot_state/config.botUsername` me publish karta
#    hai, isliye ye env optional hai — par daal doge to deep-link turant banega.
#    Value @ ke bina:  jaise  shd_delivery_bot
TELEGRAM_BOT_USERNAME=""

# Site ke header/popup wala "Join Telegram" CTA (public link).
# Khaali ya placeholder chhoda to UI me CTA hi nahi dikta (dead link fix).
NEXT_PUBLIC_TELEGRAM_URL=""

# ❌ NEXT_PUBLIC_TELEGRAM_CHANNEL_URL — ab ISKA KOI USE NAHI.
#    Ye purane JS-bot (botHandoff.ts) ke liye tha jo delete ho chuka hai.
#    Vercel me daala hai to hata do. Join-gate ka channel Admin Panel →
#    Telegram Bot Delivery → "Channel join gate" me set hota hai
#    (ya bot ke env me JOIN_GATE_CHANNEL).

# (optional) Content guard band karna ho to "1" kar dein
# NEXT_PUBLIC_DISABLE_CONTENT_GUARD="1"

# ⚠️ BOT SERVICE (Render / Railway / VPS) par ADMIN_SESSION_SECRET ki SAME value
#    daalni hai — isi se encrypted media vault decrypt hota hai.
#    Details: telegram-bot/README.md

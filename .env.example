# ==============================================================================
# STUDY HELPER DOC — 100% SERVER-ONLY ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# Copy this file to `.env` for local development, or add these keys in:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# 1. PUBLIC DOMAIN / BRANDING PLACEHOLDERS
NEXT_PUBLIC_SITE_URL="https://studyhelperdoc.vercel.app"
TELEGRAM_JOIN_URL="https://t.me/REPLACE_WITH_YOUR_TELEGRAM_CHANNEL"
DEFAULT_IMAGE_URL=""
APP_LOGO_URL=""
DEFAULT_YOUTUBE_URL=""

# 2. ADMIN LOGIN ID & PASSWORD (REQUIRED — ZERO DEFAULT PASSWORD IN CODE!)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# 3. FIREBASE REALTIME DATABASE + SERVICE ACCOUNT (SERVER-ONLY)
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_URL=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# 4. OPTIONAL: TELEGRAM & CLOUDFLARE EDGE STREAM WORKER
# (You DO NOT have to put these in Vercel .env — you can paste & encrypt them
# directly inside `/admin` -> `Telegram Sync Studio` & `Website Settings`!)
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_SESSION_STRING=""

# 🤖 @BotFather BOT TOKEN (STRONGLY RECOMMENDED — 100% FREE)
# Bot ko apne channel/group me ADMIN bana dein. Iske baad saari video/PDF
# streaming BOT se hoti hai -> har Vercel/Cloudflare container apni alag
# temporary auth_key banata hai -> `406 AUTH_KEY_DUPLICATED` KABHI nahi aata,
# aur channel ko 100% PRIVATE rakh sakte hain.
# Bot token yahan ya /admin -> Telegram Sync Studio (Box 1) me daal sakte hain.
TELEGRAM_BOT_TOKEN=""

CLOUDFLARE_STREAM_WORKER_URL=""
